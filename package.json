{
  "name": "hackatime-heartbeats-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Reads Hackatime/WakaTime-style heartbeat exports and renders activity charts, session breakdowns, and coding stats. Styled after the Hack Club brand.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "eval:authenticity": "node --experimental-strip-types scripts/eval-authenticity.mts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
